@page
@model TiendaWeb.Pages.Productos.IndexModel

@{
    ViewData["Title"] = "Productos";
}

<h1>Productos</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Nuevo producto</a>
</p>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input asp-for="Buscar" class="form-control" placeholder="Buscar por nombre..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Buscar</button>
        <a asp-page="./Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Producto[0].Nombre)</th>
            <th>@Html.DisplayNameFor(model => model.Producto[0].Precio)</th>
            <th>@Html.DisplayNameFor(model => model.Producto[0].FechaRegistro)</th>
            <th>@Html.DisplayNameFor(model => model.Producto[0].Stock)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Producto) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
            <td>@Html.DisplayFor(modelItem => item.Precio)</td>
            <td>@Html.DisplayFor(modelItem => item.FechaRegistro)</td>
            <td>@Html.DisplayFor(modelItem => item.Stock)</td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalles</a>
                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
